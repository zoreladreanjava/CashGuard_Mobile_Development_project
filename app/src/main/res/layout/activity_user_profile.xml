<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#214457"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <Button
        android:id="@+id/btnProfileBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent"
        android:textAllCaps="false"
        android:layout_gravity="start"
        android:padding="0dp"
        style="?android:attr/borderlessButtonStyle"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Info"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_gravity="start"/>

    <!-- Circular Profile Image -->
    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#2A5A73"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cashguard_logo"
            android:padding="20dp"
            android:scaleType="centerInside"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvProfileDetailName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="60dp"/>

    <Button
        android:id="@+id/btnProfileBackHome"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Home"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp"
        style="?android:attr/borderlessButtonStyle"/>

    <Button
        android:id="@+id/btnProfileLogout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Logout"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"/>

</LinearLayout>