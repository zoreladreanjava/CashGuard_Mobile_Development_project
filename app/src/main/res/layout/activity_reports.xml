<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_teal"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financial Reports"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <!-- Total Savings Card -->
            <LinearLayout
                android:id="@+id/cardTotalSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/accent_green"
                android:padding="24dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Total Savings"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvTotalSavingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱45,230.00"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Total Spending Card -->
            <LinearLayout
                android:id="@+id/cardTotalSpending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/error_red"
                android:padding="24dp"
                android:orientation="vertical"
                android:layout_marginBottom="32dp"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Spending"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvTotalSpendingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱12,450.50"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Bar Chart Placeholder -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yearly Savings Analysis"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_rounded_card"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="bottom"
                android:layout_marginBottom="16dp">

                <!-- Bar 1 -->
                <View
                    android:id="@+id/barJan"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@color/accent_green"/>
                <!-- Bar 2 -->
                <View
                    android:id="@+id/barFeb"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@color/accent_green"/>
                <!-- Bar 3 -->
                <View
                    android:id="@+id/barMar"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@color/accent_green"/>
                <!-- Bar 4 -->
                <View
                    android:id="@+id/barApr"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@color/accent_green"/>
                <!-- Bar 5 -->
                <View
                    android:id="@+id/barMay"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:background="@color/accent_green"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JAN   FEB   MAR   APR   MAY" android:textColor="@color/text_hint" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>